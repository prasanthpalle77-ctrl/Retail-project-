NOVARETAIL_ENV=dev
NOVARETAIL_PROJECT_ROOT=
NOVARETAIL_LOG_LEVEL=INFO

# Databricks authentication. Leave blank for local development.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_AUTH_TYPE=

# Optional RAG provider. Local mode does not require an API key.
RAG_PROVIDER=local
LLM_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
